# CineAI / CAIC Streaming - Variáveis de Ambiente de Exemplo
# Copie este arquivo para .env e preencha suas credenciais

# Chave da API do Google Gemini
VITE_GEMINI_API_KEY=sua_chave_gemini_aqui

# Configurações do Resend (E-mails OTP de autenticação)
RESEND_API_KEY=re_sua_chave_resend_aqui
VITE_RESEND_API_KEY=re_sua_chave_resend_aqui
